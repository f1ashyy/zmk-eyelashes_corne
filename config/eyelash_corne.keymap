#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

//#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
//#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_rgb>;
        };

        caps_rgb: caps_rgb {
            compatible = "zmk,behavior-macro";
            display-name = "Caps Lock + RGB Toggle";
            #binding-cells = <0>;
            bindings = <&kp CAPS>, <&rgb_ug RGB_TOG>;
        };

        comma_morph: comma_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Comma Morph";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN>, <&kp COMMA>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_morph: dot_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Dot Morph";
            #binding-cells = <0>;
            bindings = <&kp GREATER_THAN>, <&kp DOT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    /**/
    /*     rsr_vol: rsr_vol { */
    /*         compatible = "zmk,behavior-runtime-sensor-rotate"; */
    /*         #sensor-binding-cells = <0>; */
    /*         tap-ms = <5>; */
    /*         cw-binding = <&kp C_VOL_UP>; */
    /*         ccw-binding = <&kp C_VOL_DN>; */
    /*     }; */
    /**/
    /*     rsr_trans: rsr_trans { */
    /*         compatible = "zmk,behavior-runtime-sensor-rotate"; */
    /*         #sensor-binding-cells = <0>; */
    /*         tap-ms = <0>; */
    /*     }; */
    };

   combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        kuntem {
            display-name = "KUNTEM";
            bindings = <
&kp ESCAPE      &kp V      &kp L  &kp N                    &kp D         &kp K        &none                   &kp Q         &kp W  &kp O          &kp U       &kp J      &tog 4
&kp TAB         &kp T      &kp S  &kp R                    &kp H         &kp F        &none   &none   &none   &kp G         &kp C  &kp A          &kp I       &kp E      &kp SQT
&kp LEFT_SHIFT  &kp EQUAL  &kp Z  &kp X                    &kp P         &kp B        &none   &none           &kp M         &kp Y  &comma_morph   &dot_morph  &kp SLASH  &kp LEFT_ALT
                                  &mt LEFT_CONTROL ESCAPE  &kp LEFT_GUI  &lt 2 SPACE                          &lt 1 RETURN  &td0   &kp BACKSPACE
            >;

        };

        nav {
            display-name = "NAV";
            bindings = <
&trans     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5       &none                   &kp N6         &kp N7    &kp N8        &kp N9      &kp N0   &kp INS
&to 0      &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp Z        &none   &none   &none   &kp F          &kp H     &kp J         &kp K       &kp L    &kp DELETE
&kp LC(Z)  &kp LC(A)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)    &none   &none           &kp PAGE_DOWN  &kp HOME  &comma_morph  &dot_morph  &kp END  &kp PAGE_UP
                                 &trans     &trans     &lt 3 SPACE                          &trans         &trans    &trans
            >;

        };

        symbol {
            display-name = "SYMBOL";
            bindings = <
&kp LC(Z)  &kp LC(Y)  &kp COLON      &kp SEMICOLON  &kp PRCNT  &kp AT     &none                   &kp PIPE  &kp UNDER         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF
&tog 1     &kp TILDE  &kp MINUS      &kp PLUS       &kp ASTRK  &kp CARET  &none   &none   &none   &kp DLLR  &kp LBRC          &kp LPAR          &kp RPAR           &kp RBRC         &kp DQT
&kp LC(X)  &kp LC(C)  &kp BACKSLASH  &kp AMPS       &kp EXCL   &kp LC(V)  &none   &none           &kp HASH  &kp GRAVE         &comma_morph      &dot_morph         &kp QMARK        &trans
                                     &trans         &trans     &trans                             &trans    &kp LEFT_CONTROL  &trans
            >;

        };

        fn {
            display-name = "FN";
            bindings = <
&studio_unlock  &kp F1        &kp F2          &kp F3        &kp F4        &kp F5      &none                   &kp F6          &kp F7           &kp F8               &kp F9                   &kp F10          &kp F11
&bt BT_PRV      &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_NXT  &none   &none   &none   &kp SCROLLLOCK  &kp PRINTSCREEN  &kp LG(PRINTSCREEN)  &kp LG(LS(PRINTSCREEN))  &kp PAUSE_BREAK  &kp F12
&bt BT_DISC 0   &bt BT_CLR    &bt BT_CLR_ALL  &bootloader   &sys_reset    &soft_off   &none   &none           &bl BL_DEC      &rgb_ug RGB_BRD  &bootloader          &rgb_ug RGB_TOG          &rgb_ug RGB_BRI  &trans
                                              &trans        &trans        &trans                              &trans          &trans           &trans
            >;

        };

        placeholder {
            display-name = "PLACEHOLDER";
            bindings = <
&rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_EFF  &none                   &bl BL_SET 100  &kp W  &kp O         &kp U       &kp J      &trans
&rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &none   &none   &none   &kp G           &kp C  &kp A         &kp I       &kp E      &kp SQT
&trans           &kp Z            &kp Z            &kp X            &kp P            &kp B            &none   &none           &kp M           &kp Y  &comma_morph  &dot_morph  &kp SLASH  &trans
                                                   &trans           &lt 2 SPACE      &lt 2 SPACE                              &lt 1 RETURN    &td0   &trans
            >;

        };
    };
};
