#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

//#include <input/processors.dtsi>

#include <zephyr/dt-bindings/input/input-event-codes.h>

//#include <behaviors/runtime-sensor-rotate.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_rgb>;
        };

        caps_rgb: caps_rgb {
            compatible = "zmk,behavior-macro";
            display-name = "Caps Lock + RGB Toggle";
            #binding-cells = <0>;
            bindings = <&kp CAPS &rgb_ug RGB_TOG>;
        };

        num_func: num_func {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NUM_FUNC";
        };

        comma_morph: comma_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Comma Morph";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN>, <&kp COMMA>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_morph: dot_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Dot Morph";
            #binding-cells = <0>;
            bindings = <&kp GREATER_THAN>, <&kp DOT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <5 4 3 2 1 0 13 14 15 16 17 18 33 32 31 30 29 28 47>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <80>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <80>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 47>;
        };

        pos_fast_hold_tap: pos_fast_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "POS_FAST_HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <115>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 46>;
            quick-tap-ms = <115>;
        };

        fast_th: fast_th {
            compatible = "zmk,behavior-hold-tap";
            label = "FAST_TH";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <115>;
            flavor = "balanced";
            quick-tap-ms = <115>;
        };

        pos_fast_layer_tap: pos_fast_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "POS_FAST_LAYER_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <120>;
            flavor = "tap-preferred";
            quick-tap-ms = <120>;
        };

        gui_tab: gui_tab {
            compatible = "zmk,behavior-hold-tap";
            label = "GUI_TAB";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <115>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 46>;
            quick-tap-ms = <115>;
        };

        sh_esc: sh_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "SH_ESC";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <115>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 42>;
            quick-tap-ms = <115>;
        };

        dquote_morph: dquote_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Dot Morph";
            #binding-cells = <0>;
            bindings = <&kp GREATER_THAN>, <&kp DOUBLE_QUOTES>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "DQUOTE_MORPH";
        };

        squote_morph: squote_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Dot Morph";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN>, <&kp SINGLE_QUOTE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "SQUOTE_MORPH";
        };

        sticky_sh_esc: sticky_sh_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_SH_ESC";
            bindings = <&sk>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <115>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 42>;
            quick-tap-ms = <115>;
        };

        slow_layer_tap: slow_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "SLOW_LAYER_TAP";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
        };

        medium_layer_tap: medium_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MEDIUM_LAYER_TAP";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <275>;
        };

        /**/
        /*     rsr_vol: rsr_vol { */
        /*         compatible = "zmk,behavior-runtime-sensor-rotate"; */
        /*         #sensor-binding-cells = <0>; */
        /*         tap-ms = <5>; */
        /*         cw-binding = <&kp C_VOL_UP>; */
        /*         ccw-binding = <&kp C_VOL_DN>; */
        /*     }; */
        /**/
        /*     rsr_trans: rsr_trans { */
        /*         compatible = "zmk,behavior-runtime-sensor-rotate"; */
        /*         #sensor-binding-cells = <0>; */
        /*         tap-ms = <0>; */
        /*     }; */
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        L_CTRL {
            bindings = <&sk LCTRL>;
            key-positions = <15 16 17>;
        };

        R_CTRL {
            bindings = <&sk RCTRL>;
            key-positions = <23 24 25>;
        };

        L_ALT {
            bindings = <&sk LALT>;
            key-positions = <15 14 16>;
        };

        R_ALT {
            bindings = <&sk RALT>;
            key-positions = <24 25 26>;
        };

        semicolon {
            bindings = <&kp SEMI>;
            key-positions = <39 38>;
            timeout-ms = <60>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <17 4>;
        };

        double_quotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <8 23>;
        };

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <30 39>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <3 2>;
            layers = <2>;
        };

        redo {
            bindings = <&kp LC(Y)>;
            key-positions = <3 4>;
            layers = <2>;
        };

        select_all {
            bindings = <&kp LC(A)>;
            key-positions = <15 16>;
            layers = <2>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <15 17>;
            layers = <2>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <17 16>;
            layers = <2>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <31 32>;
            layers = <2>;
        };

        ter_paste {
            bindings = <&kp LC(LS(V))>;
            key-positions = <31 30>;
            layers = <2>;
        };

        ter_copy {
            bindings = <&kp LC(LS(C))>;
            key-positions = <16 18>;
            layers = <2>;
        };

        L_SHIFT {
            bindings = <&sk LSHFT>;
            key-positions = <15 16 18>;
        };

        R_SHIFT {
            bindings = <&sk RSHFT>;
            key-positions = <25 24 22>;
        };

        tog_gallium {
            bindings = <&tog 5>;
            key-positions = <2 3 4 1>;
        };

        l_ctrl+l_alt {
            bindings = <&kp LC(LALT)>;
            key-positions = <14 15 16 17>;
        };

        r_ctrl+r_alt {
            bindings = <&kp LC(LALT)>;
            key-positions = <23 24 25 26>;
        };

        r_tab {
            bindings = <&kp TAB>;
            key-positions = <8 9 10>;
        };

        l_tab {
            bindings = <&kp TAB>;
            key-positions = <2 3 4>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        kuntem {
            display-name = "KUNTEM";
            bindings = <
&none  &kp V      &kp L  &kp N              &kp D  &kp K                      &none         &kp Q                         &kp W                         &kp O          &kp U       &kp J      &none
&none  &kp T      &kp S  &kp R              &kp H  &kp F               &none  &none  &none  &kp G                         &kp C                         &kp A          &kp I       &kp E      &none
&none  &kp EQUAL  &kp Z  &kp X              &kp P  &kp B      &none           &none         &kp M                         &kp Y                         &comma_morph   &dot_morph  &kp SLASH  &none
                         &gui_tab LGUI TAB  &sl 2  &kp SPACE                                &pos_fast_layer_tap 1 RETURN  &sticky_sh_esc RSHIFT ESCAPE  &kp BACKSPACE
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&none  &kp N1    &kp N2         &kp N3       &kp N4     &kp N5                                     &none         &kp N6      &kp N7  &kp N8     &kp N9      &kp N0     &none
&none  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &kp CARET                           &none  &none  &none  &kp DOLLAR  &kp H   &kp J      &kp K       &kp L      &none
&none  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp HOME                   &none           &none         &kp END     &none   &kp COMMA  &kp PERIOD  &kp SLASH  &none
                                &trans       &trans     &medium_layer_tap 3 SPACE                                &trans      &trans  &trans
            >;
        };

        symbol {
            display-name = "SYMBOL";
            bindings = <
&none  &kp GRAVE  &kp UNDER      &kp COLON  &kp PRCNT  &kp EXCL                                     &none         &kp AT      &kp LC(BACKSPACE)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none      &none
&none  &kp TILDE  &kp MINUS      &kp PLUS   &kp ASTRK  &kp AMPERSAND                         &none  &none  &none  &kp PIPE    &kp LBRC           &kp LPAR          &kp RPAR           &kp RBRC   &none
&none  &kp EQUAL  &kp BACKSLASH  &kp AMPS   &kp EXCL   &kp CARET                    &none           &none         &kp DOLLAR  &kp HASH           &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp SLASH  &none
                                 &trans     &trans     &pos_fast_layer_tap 1 SPACE                                &trans      &trans             &trans
            >;
        };

        fn {
            display-name = "FN";
            bindings = <
&none  &kp F1        &kp F2        &kp F3            &kp F4        &kp F5                        &none         &kp F6      &kp F7           &kp F8               &kp F9                   &kp F10  &none
&none  &kp C_PREV    &kp C_RW      &kp C_PLAY_PAUSE  &kp C_FF      &kp C_NEXT             &none  &none  &none  &kp DELETE  &kp PRINTSCREEN  &kp LG(PRINTSCREEN)  &kp LG(LS(PRINTSCREEN))  &kp F11  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &none           &none         &tog 4      &caps_rgb        &kp SCROLLLOCK       &kp INSERT               &kp F12  &none
                                   &trans            &trans        &trans                                      &trans      &trans           &trans
            >;
        };

        misc {
            display-name = "MISC";
            bindings = <
&none  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                  &none         &bl BL_SET 100  &kp W       &kp O        &kp U       &kp J      &none
&none  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_EFR           &none  &none  &none  &kp G           &kp C       &kp A        &kp I       &kp E      &none
&none  &bt BT_CLR_ALL   &bt BT_CLR       &bootloader      &sys_reset       &rgb_ug RGB_TOG  &none           &none         &to 0           &sys_reset  &bootloader  &dot_morph  &kp SLASH  &none
                                         &trans           &trans           &trans                                         &trans          &trans      &trans
            >;
        };

        gallium {
            bindings = <
&none  &kp B  &kp L  &kp D   &kp C   &kp V                   &none         &kp J   &kp Y   &kp O          &kp U          &none     &none
&none  &kp N  &kp R  &kp T   &kp S   &kp G            &none  &none  &none  &kp P   &kp H   &kp A          &kp E          &kp I     &none
&none  &kp X  &kp Q  &kp M   &kp W   &kp Z   &none           &none         &kp K   &kp F   &squote_morph  &dquote_morph  &kp FSLH  &none
                     &trans  &trans  &trans                                &trans  &trans  &trans
            >;

            label = "GALLIUM";
        };
    };
};
