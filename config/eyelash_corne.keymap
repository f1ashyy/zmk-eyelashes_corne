#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

//#include <input/processors.dtsi>

#include <zephyr/dt-bindings/input/input-event-codes.h>

//#include <behaviors/runtime-sensor-rotate.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_rgb>;
        };

        caps_rgb: caps_rgb {
            compatible = "zmk,behavior-macro";
            display-name = "Caps Lock + RGB Toggle";
            #binding-cells = <0>;
            bindings = <&kp CAPS &rgb_ug RGB_TOG>;
        };

        num_func: num_func {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NUM_FUNC";
        };

        comma_morph: comma_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Comma Morph";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN>, <&kp COMMA>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_morph: dot_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Dot Morph";
            #binding-cells = <0>;
            bindings = <&kp GREATER_THAN>, <&kp DOT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <5 4 3 2 1 0 13 14 15 16 17 18 33 32 31 30 29 28 47>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <80>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <80>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 47>;
        };

        pos_fast_hold_tap: pos_fast_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "POS_FAST_HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <115>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 46>;
            quick-tap-ms = <115>;
        };

        fast_th: fast_th {
            compatible = "zmk,behavior-hold-tap";
            label = "FAST_TH";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <115>;
            flavor = "balanced";
            quick-tap-ms = <115>;
        };

        pos_fast_layer_tap: pos_fast_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "POS_FAST_LAYER_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <120>;
            flavor = "tap-preferred";
            quick-tap-ms = <120>;
        };

        gui_tab: gui_tab {
            compatible = "zmk,behavior-hold-tap";
            label = "GUI_TAB";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <115>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 46>;
            quick-tap-ms = <115>;
        };

        sh_esc: sh_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "SH_ESC";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <115>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 42>;
            quick-tap-ms = <115>;
        };

        dquote_morph: dquote_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Dot Morph";
            #binding-cells = <0>;
            bindings = <&kp GREATER_THAN>, <&kp DOUBLE_QUOTES>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "DQUOTE_MORPH";
        };

        squote_morph: squote_morph {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Dot Morph";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN>, <&kp SINGLE_QUOTE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "SQUOTE_MORPH";
        };

        /**/
        /*     rsr_vol: rsr_vol { */
        /*         compatible = "zmk,behavior-runtime-sensor-rotate"; */
        /*         #sensor-binding-cells = <0>; */
        /*         tap-ms = <5>; */
        /*         cw-binding = <&kp C_VOL_UP>; */
        /*         ccw-binding = <&kp C_VOL_DN>; */
        /*     }; */
        /**/
        /*     rsr_trans: rsr_trans { */
        /*         compatible = "zmk,behavior-runtime-sensor-rotate"; */
        /*         #sensor-binding-cells = <0>; */
        /*         tap-ms = <0>; */
        /*     }; */
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        L_CTRL {
            bindings = <&sk LCTRL>;
            key-positions = <15 16 17>;
        };

        R_CTRL {
            bindings = <&sk RCTRL>;
            key-positions = <23 24 25>;
        };

        L_ALT {
            bindings = <&sk LALT>;
            key-positions = <15 14 16>;
        };

        R_ALT {
            bindings = <&sk RALT>;
            key-positions = <24 25 26>;
        };

        semicolon {
            bindings = <&kp SEMI>;
            key-positions = <39 38>;
            timeout-ms = <60>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <17 4>;
        };

        double_quotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <8 23>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        kuntem {
            display-name = "KUNTEM";
            bindings = <
&none  &kp V      &kp L  &kp N              &kp D  &kp K                      &none         &kp Q                         &kp W                  &kp O          &kp U          &kp J      &none
&none  &kp T      &kp S  &kp R              &kp H  &kp F               &none  &none  &none  &kp G                         &kp C                  &kp A          &kp I          &kp E      &none
&none  &kp EQUAL  &kp Z  &kp X              &kp P  &kp B      &none           &none         &kp M                         &kp Y                  &squote_morph  &dquote_morph  &kp SLASH  &none
                         &gui_tab LGUI TAB  &mo 2  &kp SPACE                                &pos_fast_layer_tap 1 RETURN  &sh_esc RSHIFT ESCAPE  &kp BACKSPACE
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&none  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                        &none         &kp N6      &kp N7  &kp N8     &kp N9      &kp N0     &none
&none  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp CARET              &none  &none  &none  &kp DOLLAR  &kp H   &kp J      &kp K       &kp L      &none
&none  &kp LC(A)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(HOME)  &none           &none         &kp END     &none   &kp COMMA  &kp PERIOD  &kp SLASH  &none
                             &trans     &trans     &lt 3 SPACE                                 &trans      &trans  &trans
            >;
        };

        symbol {
            display-name = "SYMBOL";
            bindings = <
&none  &kp GRAVE  &kp COLON      &kp LC(BACKSPACE)  &kp PRCNT  &kp AT                         &none         &kp PIPE    &kp UNDER  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp GRAVE  &none
&none  &kp TILDE  &kp MINUS      &kp PLUS           &kp ASTRK  &kp AMPERSAND           &none  &none  &none  &kp PIPE    &kp LBRC   &kp LPAR          &kp RPAR           &kp RBRC   &none
&none  &trans     &kp BACKSLASH  &kp AMPS           &kp EXCL   &kp CARET      &none           &none         &kp DOLLAR  &kp HASH   &comma_morph      &dot_morph         &kp QMARK  &none
                                 &trans             &trans     &trans                                       &trans      &trans     &trans
            >;
        };

        fn {
            display-name = "FN";
            bindings = <
&none  &kp F1        &kp F2          &kp F3        &kp F4        &kp F5                      &none         &kp F6          &kp F7           &kp F8               &kp F9                   &kp F10  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_NXT           &none  &none  &none  &kp SCROLLLOCK  &kp PRINTSCREEN  &kp LG(PRINTSCREEN)  &kp LG(LS(PRINTSCREEN))  &kp F11  &none
&none  &bt BT_CLR    &bt BT_CLR_ALL  &bootloader   &sys_reset    &soft_off   &none           &none         &bl BL_DEC      &rgb_ug RGB_BRD  &bootloader          &rgb_ug RGB_TOG          &kp F12  &none
                                     &trans        &trans        &trans                                    &trans          &trans           &trans
            >;
        };

        placeholder {
            display-name = "PLACEHOLDER";
            bindings = <
&none  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_EFF                  &none         &bl BL_SET 100  &kp W  &kp O         &kp U       &kp J      &none
&none  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR           &none  &none  &none  &kp G           &kp C  &kp A         &kp I       &kp E      &none
&none  &kp Z            &kp Z            &kp X            &kp P            &kp B            &none           &none         &kp M           &kp Y  &comma_morph  &dot_morph  &kp SLASH  &none
                                         &trans           &lt 2 SPACE      &lt 2 SPACE                                    &lt 1 RETURN    &td0   &trans
            >;
        };
    };
};
